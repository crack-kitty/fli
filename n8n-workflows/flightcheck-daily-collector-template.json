    {
      "parameters": {
        "jsCode": "const today = new Date();\nconst runDate = today.toISOString().split('T')[0];\nconst items = $input.all();\nconst pairs = [];\n\nconst enabled = items.filter(i => i.json.enabled === true || i.json.enabled === 'TRUE');\n\nfor (const item of enabled) {\n  const iata = item.json.iata_code;\n  const name = item.json.destination_name;\n\n  for (const weeksOut of [4, 8, 12]) {\n    const d = new Date(today);\n    d.setDate(d.getDate() + weeksOut * 7);\n    const dateStr = d.toISOString().split('T')[0];\n\n    pairs.push({\n      json: {\n        iata_code: iata,\n        destination_name: name,\n        departure_date: dateStr,\n        run_date: runDate\n      }\n    });\n  }\n}\n\nreturn pairs;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        576,
        320
      ],
      "name": "Generate Search Pairs"
    },
    {
      "parameters": {
        "batchSize": 3,
        "options": {}
      },
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        768,
        320
      ],
      "name": "Loop Searches"
    },
    {
      "parameters": {
        "jsCode": "const item = $json;\nconst baseUrl = 'http://YOUR_FLIGHTCHECK_HOST:8000/mcp';\nconst headers = {\n  'Content-Type': 'application/json',\n  'Accept': 'application/json, text/event-stream'\n};\n\n// Step 1: Initialize MCP session\nconst initRes = await this.helpers.httpRequest({\n  method: 'POST',\n  url: baseUrl,\n  headers,\n  body: {\n    jsonrpc: '2.0',\n    id: 1,\n    method: 'initialize',\n    params: {\n      protocolVersion: '2024-11-05',\n      capabilities: {},\n      clientInfo: { name: 'n8n-flightcheck', version: '1.0.0' }\n    }\n  },\n  returnFullResponse: true,\n  timeout: 30000,\n});\nconst sessionId = initRes.headers['mcp-session-id'];\n\n// Step 2: Send initialized notification\nawait this.helpers.httpRequest({\n  method: 'POST',\n  url: baseUrl,\n  headers: { ...headers, 'mcp-session-id': sessionId },\n  body: {\n    jsonrpc: '2.0',\n    method: 'notifications/initialized'\n  },\n  returnFullResponse: true,\n  timeout: 30000,\n});\n\n// Step 3: Call search_flights\nconst searchRes = await this.helpers.httpRequest({\n  method: 'POST',\n  url: baseUrl,\n  headers: { ...headers, 'mcp-session-id': sessionId },\n  body: {\n    jsonrpc: '2.0',\n    id: 3,\n    method: 'tools/call',\n    params: {\n      name: 'search_flights',\n      arguments: {\n        origin: 'ALB',\n        destination: item.iata_code,\n        departure_date: item.departure_date,\n        cabin_class: 'ECONOMY',\n        passengers: 1\n      }\n    }\n  },\n  returnFullResponse: true,\n  json: false,\n  timeout: 30000,\n});\n\nreturn [{\n  json: {\n    iata_code: item.iata_code,\n    destination_name: item.destination_name,\n    departure_date: item.departure_date,\n    run_date: item.run_date,\n    data: searchRes.body,\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        928,
        416
      ],
      "name": "Search Flights",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const loopItem = $json;\n\nconst airportCodes = {\n  \"Chicago O'Hare International Airport\": \"ORD\",\n  \"Washington Dulles International Airport\": \"IAD\",\n  \"Denver International Airport\": \"DEN\"\n};\n\nfunction toAirportCode(name) {\n  if (!name) return null;\n  if (airportCodes[name]) return airportCodes[name];\n  if (name.length === 3) return name.toUpperCase();\n  return name;\n}\n\ntry {\n  const rawData = $json.data || $json.body || '';\n\n  let flightData = null;\n  const lines = rawData.split('\\n');\n  for (const line of lines) {\n    const trimmed = line.trim();\n    if (trimmed.startsWith('data: ')) {\n      try {\n        const parsed = JSON.parse(trimmed.substring(6));\n        if (parsed.result && parsed.result.content) {\n          for (const content of parsed.result.content) {\n            if (content.type === 'text' && content.text) {\n              flightData = JSON.parse(content.text);\n            }\n          }\n        }\n      } catch (e) { }\n    }\n  }\n\n  if (!flightData || !flightData.flights || flightData.flights.length === 0) {\n    return [{ json: { ...loopItem,\n      destination_name: loopItem.destination_name.replace(/'/g, \"''\"), price: null, found: false } }];\n  }\n\n  const unitedFlights = flightData.flights.filter(f => {\n    if (!f.legs || f.legs.length === 0) return false;\n    if (f.legs.length > 2) return false;\n    const hasUnited = f.legs.some(leg =>\n      leg.airline && leg.airline.toLowerCase().includes('united')\n    );\n    return hasUnited;\n  });\n\n  if (unitedFlights.length === 0) {\n    return [{ json: { ...loopItem,\n      destination_name: loopItem.destination_name.replace(/'/g, \"''\"), price: null, found: false } }];\n  }\n\n  unitedFlights.sort((a, b) => a.price - b.price);\n  const best = unitedFlights[0];\n\n  const stops = best.legs.length - 1;\n  let layover = null;\n  if (stops === 1 && best.legs.length >= 2) {\n    layover = toAirportCode(best.legs[0].arrival_airport);\n  }\n  const totalDuration = best.legs.reduce((sum, leg) => sum + (leg.duration || 0), 0);\n\n  return [{\n    json: {\n      ...loopItem,\n      destination_name: loopItem.destination_name.replace(/'/g, \"''\"),\n      price: best.price,\n      airline: 'United Airlines',\n      stops: stops,\n      layover_airport: layover,\n      layover_airport_sql: layover ? \"'\" + layover + \"'\" : 'NULL',\n      flight_duration: totalDuration,\n      found: true\n    }\n  }];\n} catch (e) {\n  return [{ json: { ...loopItem,\n      destination_name: loopItem.destination_name.replace(/'/g, \"''\"), price: null, found: false, error: e.message } }];\n}"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1136,
        416
      ],
      "name": "Parse and Filter"
