{
  "name": "FlightCheck - Daily Collector",
  "description": "Searches Google Flights via fli MCP server for watchlist destinations, stores prices in Postgres, logs to Google Sheets, and triggers the Alert Engine.",
  "nodes": [
    {
      "parameters": {},
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        208,
        512
      ],
      "name": "Manual Trigger"
    },
